# copialo a .env (que esta en .gitignore) y completalo. docker compose lo lee solo.
#
# printscript-service baja org.printscript:runner de GitHub Packages al compilar, y Packages pide
# credenciales aunque el repo sea publico. El token necesita el scope read:packages.
GITHUB_ACTOR=tu-usuario-de-github
GITHUB_TOKEN=ghp_xxx
